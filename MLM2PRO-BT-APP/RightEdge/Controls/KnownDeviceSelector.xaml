<UserControl x:Class="MLM2PRO_BT_APP.RightEdge.Controls.KnownDeviceSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MLM2PRO_BT_APP.RightEdge.Controls"
             mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        
        <Button Grid.Row="1" x:Name="DeviceSelector" Width="190" HorizontalContentAlignment="Stretch" ToolTip="Select Putt Tracker Device" Click="DeviceSelector_Click">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="DeviceSelectorCurrentSelection" HorizontalAlignment="Left" FontSize="13" Text="Default Device" Tag="default" />
                <TextBlock Grid.Column="1" Text=" ▼" HorizontalAlignment="Right" Margin="5,0,0,0"/>
            </Grid>

            <Button.ContextMenu>
                <ContextMenu x:Name="DeviceSelectorMenuFlyout">
                    <MenuItem Header="Default Device" Tag="default" Click="DeviceSelectorMenuFlyoutItem_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <StackPanel x:Name="NoDevicesPanel" Orientation="Vertical" Visibility="Collapsed">
            <TextBlock x:Name="NoDevicesTextBlock1" FontSize="13" FontFamily="Arial" FontWeight="Bold" Foreground="DarkRed"  Margin="0 2" VerticalAlignment="Bottom" TextAlignment="Left">No Known Devices</TextBlock>
            <TextBlock x:Name="NoDevicesTextBlock2" FontSize="12" FontFamily="Arial" Margin="0 2" VerticalAlignment="Bottom" TextAlignment="Left" TextWrapping="Wrap">(Run putt tracker simulation software to setup/configure your Putt Tracker device.)</TextBlock>
        </StackPanel>

    </Grid>
</UserControl>
